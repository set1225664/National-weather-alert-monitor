```env
# ==================================
# Severe Weather Alert Configuration
# Nationwide United States Monitoring
# ==================================

# National Weather Service API
NWS_API_URL=https://api.weather.gov

# ==================================
# Geographic Monitoring
# ==================================

# Monitor entire United States
# Uses NWS active alerts endpoint
MONITOR_SCOPE=UNITED_STATES

# Supported areas:
# UNITED_STATES = All active US weather alerts
# STATE = Single state monitoring
# ZONE = Specific NWS forecast zones

# ==================================
# Alert Filtering
# ==================================

# Minimum severity level to send notifications
# Options:
# Minor
# Moderate
# Severe
# Extreme
MIN_ALERT_SEVERITY=Severe

# Alert categories to monitor
# Examples:
# Tornado Warning
# Severe Thunderstorm Warning
# Flash Flood Warning
# Hurricane Warning
# Winter Storm Warning
# Blizzard Warning
MONITOR_ALL_HAZARDS=true

# Only send active alerts
ACTIVE_ALERTS_ONLY=true

# ==================================
# Email Configuration
# ==================================

SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587

EMAIL_FROM=shipping@boatfix.com
EMAIL_TO=ops@boatfix.com

# Use an application password
# Never commit this value to GitHub
EMAIL_PASSWORD=your_app_password

# ==================================
# Weather Map Generation
# ==================================

# Attach national weather maps to emails
GENERATE_MAPS=true

# Map image quality
MAP_DPI=150

# Include:
# - Alert polygons
# - Radar imagery
# - Warning locations
INCLUDE_ALERT_MAPS=true

# ==================================
# Monitoring Schedule
# ==================================

# Check NWS alerts every X minutes
CHECK_INTERVAL=15

# ==================================
# Logging
# ==================================

LOG_LEVEL=INFO
```
