```gitignore
# =========================
# Python
# =========================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
downloads/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# =========================
# Virtual Environments
# =========================
.venv/
venv/
env/
ENV/

# =========================
# Environment Variables
# =========================
.env
.env.local
.env.*

# =========================
# IDEs
# =========================
.vscode/
.idea/
*.swp
*.swo

# =========================
# OS Files
# =========================
.DS_Store
Thumbs.db

# =========================
# Logs
# =========================
*.log
logs/

# =========================
# Python Testing
# =========================
.pytest_cache/
.coverage
htmlcov/

# =========================
# Type Checking
# =========================
.mypy_cache/
.pyre/
.ruff_cache/

# =========================
# Jupyter
# =========================
.ipynb_checkpoints/

# =========================
# Generated Weather Maps
# =========================
output/
maps/
images/
*.png
*.jpg

# =========================
# Email Attachments
# =========================
attachments/

# =========================
# Temporary Files
# =========================
tmp/
temp/
*.tmp

# =========================
# Packaging
# =========================
*.zip
*.tar.gz

# =========================
# Local Configuration
# =========================
config.local.py
```
